# --- API ---
# Leave DATABASE_URL empty to use the embedded PGlite database at apps/api/data/pg (zero setup).
# Set it to use a real Postgres, e.g. postgres://tesseract:tesseract@localhost:5432/tesseract
DATABASE_URL=
PORT=3001
# Random 32+ char secret. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Public URL the browser uses to reach the API (auth callbacks, cookies)
BETTER_AUTH_URL=http://localhost:3001
# Comma-separated origins allowed to call the API with credentials
TRUSTED_ORIGINS=http://localhost:5173

# --- AI-assisted handoff drafts (optional; unset = feature hidden) ---
# LLM_PROVIDER=anthropic            # anthropic | openai | openai-compatible
# LLM_MODEL=claude-sonnet-4-5       # any model id the provider accepts
# LLM_API_KEY=
# LLM_BASE_URL=                     # only for openai-compatible (Ollama, vLLM, gateways), e.g. http://localhost:11434/v1

# --- WEB (Vite) ---
VITE_API_URL=http://localhost:3001
